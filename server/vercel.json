{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/api?__path=/$1" }],
  "functions": {
    "api/index.ts": { "maxDuration": 300, "memory": 3009, "includeFiles": "{playbook,web,downloads,fonts}/**" }
  },
  "crons": [
    { "path": "/api/cron/catch-up", "schedule": "5 11 * * *" },
    { "path": "/api/cron/catch-up", "schedule": "40 11 * * *" },
    { "path": "/api/cron/live", "schedule": "*/30 12-23 * * 1-5" }
  ]
}
