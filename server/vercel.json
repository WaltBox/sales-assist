{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/api?__path=/$1" }],
  "functions": {
    "api/index.ts": { "maxDuration": 300, "includeFiles": "{playbook,web}/**" }
  },
  "crons": [
    { "path": "/api/cron/catch-up", "schedule": "0 13 * * *" },
    { "path": "/api/cron/catch-up", "schedule": "45 15 * * *" }
  ]
}
