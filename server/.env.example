# Copy to .env (same folder) and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=sk-ant-...
# Only if your key is not scoped to a workspace (console.anthropic.com → Settings → Workspaces):
ANTHROPIC_WORKSPACE_ID=

# ---- Hosted (Vercel + Supabase). Leave these out to run locally with .cache files. ----
# Supabase → Project Settings → API. The service-role key stays server side only.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# From `npm run close-webhook -- https://<your-app>.vercel.app`
CLOSE_WEBHOOK_SIGNATURE_KEY=
# Any long random string; Vercel Cron sends it to /api/cron/catch-up.
CRON_SECRET=
# The extension's origin, e.g. chrome-extension://<id>
ALLOWED_ORIGINS=
# Signs sign-in sessions (any long random string). Required when hosted.
SESSION_SECRET=
